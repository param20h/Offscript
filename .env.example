# ==============================================================================
# OFFSCRIPT STUDIO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-ONLY VARIABLES (Never prefix with NEXT_PUBLIC_. Keep strictly private)
# ------------------------------------------------------------------------------

# Database: Supabase PostgreSQL
# Obtain from Supabase Project Settings -> API.
# The service-role key bypasses RLS for server-side intake. Never expose to client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Distributed Rate Limiting: Upstash Redis (Sliding-window: 3 req / 15 min)
# Obtain from console.upstash.com. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email Dispatch: Resend
# Obtain from resend.com/api-keys.
RESEND_API_KEY=
# Verified sender identity using the verified subdomain:
RESEND_FROM_EMAIL=
# Private notification recipient inbox (where studio intake notifications arrive; keep server-private)
CONTACT_NOTIFICATION_EMAIL=owner-private-inbox@example.com

# Private Agency Admin Portal (/private)
# Admin login: accepts ADMIN_PASSWORD (plaintext) or ADMIN_PASSWORD_HASH (scrypt)
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Cryptographic secret for signing HTTP-only admin session cookies (min 32 characters)
ADMIN_SESSION_SECRET=
# Canonical Studio Production Origin & Public Identity (Server-only; zero NEXT_PUBLIC_ variables)
SITE_URL=
CONTACT_EMAIL=
CALENDLY_URL=
